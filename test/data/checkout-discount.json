{
  "cartFixture": {
    "productId": 1,
    "quantity": 2,
    "unitPrice": 49.9,
    "subtotal": 99.8
  },
  "cases": [
    {
      "id": "EP-01",
      "partition": "P1: paymentMethod = cash",
      "description": "Valid partition: cash applies 10% discount on cart subtotal",
      "user": "alice",
      "paymentMethod": "cash",
      "expectedStatus": 200,
      "expected": {
        "discountRate": 0.1,
        "discountAmount": 9.98,
        "total": 89.82
      }
    },
    {
      "id": "EP-02",
      "partition": "P2: paymentMethod = credit_card",
      "description": "Valid partition: credit_card applies no discount",
      "user": "bob",
      "paymentMethod": "credit_card",
      "expectedStatus": 200,
      "expected": {
        "discountRate": 0,
        "discountAmount": 0,
        "total": 99.8
      }
    },
    {
      "id": "EP-03",
      "partition": "P3: paymentMethod invalid (not cash/credit_card)",
      "description": "Invalid partition: values outside {cash, credit_card} must be rejected; representative selected randomly: pix",
      "user": "carol",
      "paymentMethod": "pix",
      "expectedStatus": 400,
      "expected": {
        "errorContains": "paymentMethod"
      }
    }
  ]
}
